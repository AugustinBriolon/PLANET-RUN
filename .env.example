# Copy this file to .env.local and fill in the values.

# Postgres + PostGIS started with `docker compose up -d`
DATABASE_URL=postgres://planet_run:planet_run@localhost:5433/planet_run

# Auth.js session signing secret — generate with `openssl rand -base64 33`
AUTH_SECRET=
# Production only: public origin of the app, e.g. https://planet.run
# AUTH_URL=

# Strava API application — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# AES-256-GCM key encrypting Strava tokens at rest — generate with `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# Shared secret echoed by Strava when validating the webhook subscription — any random string
STRAVA_WEBHOOK_VERIFY_TOKEN=
